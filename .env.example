# ---- 数据库 ----
# Cloudflare 部署：不用填这个，改用 wrangler.jsonc 里的 Hyperdrive 绑定（推荐）。
# 其他环境（本地开发 / VPS / Docker）：填 PostgreSQL 连接串。
DATABASE_URL=postgresql://user:password@host:5432/minireel

# ---- 后台登录 ----
# 生产环境这两项都是必填：缺任意一项，后台会直接判定为「未配置」并拒绝登录。
# ADMIN_SESSION_SECRET 请用随机长字符串，例如：openssl rand -base64 48
ADMIN_PASSWORD=change-me-please
ADMIN_SESSION_SECRET=please-generate-a-long-random-string

# ---- 安装包存储：r2 或 local ----
# 不设置时：填了 R2_ACCOUNT_ID 就走 r2，否则回退到本地磁盘（.data/uploads）。
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=minireel-releases
# 可选：R2 自定义域名；配置后下载接口统计完直接 302 跳转到 CDN，不走站点流量。
R2_PUBLIC_BASE_URL=https://dl.example.com
# 可选：默认 https://<account>.r2.cloudflarestorage.com
# R2_ENDPOINT=
